{
	"name": "kroma-studio",
	"productName": "Kroma Studio",
	"version": "0.1.0",
	"description": "Desktop video editor for turning Chinese and online videos into Khmer-subtitled posts for YouTube, Facebook and TikTok",
	"main": "./out/main/index.js",
	"private": true,
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"dist": "electron-vite build && electron-builder --mac --dir"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.14.0",
		"cn": "^0.5.2",
		"msedge-tts": "^2.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/kantumruy-pro": "^5.3.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron": "^45.5.0",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"lucide-react": "^1.80.0",
		"next-themes": "^0.4.6",
		"playwright": "^1.65.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.2",
		"zustand": "^5.1.0"
	},
	"trustedDependencies": [
		"electron",
		"esbuild"
	],
	"build": {
		"appId": "kh.kroma.studio",
		"productName": "Kroma Studio",
		"directories": {
			"output": "dist",
			"buildResources": "resources"
		},
		"files": [
			"out/**",
			"package.json"
		],
		"mac": {
			"icon": "resources/icon.png",
			"category": "public.app-category.video",
			"target": [
				"dir"
			],
			"identity": null
		}
	}
}
